# Required: PostgreSQL connection string (Neon)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Required: NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Required: Secret passphrase to authorize /api/seed endpoint
SEED_SECRET="any-secret-string"

# Required: Anthropic API key for Spark chatbot
ANTHROPIC_API_KEY="sk-ant-..."

# Required: Razorpay payment gateway
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="whsec_..."

# Required: Resend email service
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Required: App public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required: Internal cron secret
CRON_SECRET="generate-a-random-secret"

# Optional: Sentry DSN for error monitoring
SENTRY_DSN=""

# Optional: Upstash Redis for distributed rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
